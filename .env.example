# Все переменные имеют префикс JOURNALS_
JOURNALS_ENV=dev
JOURNALS_LOG_LEVEL=INFO
# Токен для сбора метрик Prometheus (GET /metrics). Пусто: метод отключён. Наружу /metrics не публиковать.
JOURNALS_METRICS_TOKEN=
JOURNALS_BUSINESS_TIMEZONE=Europe/Moscow
# Список строкой JSON
JOURNALS_CORS_ORIGINS=["http://localhost:5173"]

# Пароль должен совпадать с POSTGRES_PASSWORD (docker compose подставляет его в контейнер PostgreSQL).
POSTGRES_PASSWORD=change-me
JOURNALS_DATABASE_URL=postgresql+asyncpg://journals:change-me@postgres:5432/journals
JOURNALS_REDIS_URL=redis://redis:6379/0
JOURNALS_STORAGE_DIR=/var/lib/journals/storage

# --- Предрейс ONLINE: сервисный клиент (client credentials) ---
JOURNALS_PREDREIS_BASE_URL=https://predreis-online.ru
JOURNALS_PREDREIS_CLIENT_ID=journals
# Секрет выдаёт Предрейс. Хранить только здесь, в репозиторий и чаты не попадает.
JOURNALS_PREDREIS_CLIENT_SECRET=

# --- Очередь событий осмотров (RabbitMQ Предрейса) ---
JOURNALS_RABBITMQ_URL=amqp://user:password@rabbitmq-host:5672/
JOURNALS_RABBITMQ_QUEUE=journal.events.outgoing
# Журнал ведётся с этой даты (ГГГГ-ММ-ДД); более ранние осмотры не импортируются. Пусто — все.
JOURNALS_EPL_IMPORT_FROM=

# --- Подпись электронных журналов ---
# Журнал подписывает КЭП организации ООО «ПРЕДРЕЙС» (через Предрейс, sign_as=organization): пользователь не нужен.
JOURNALS_JOURNAL_SIGN_DOCUMENT_TYPE=journal.ejournal
# Разрешить Предрейсу, Админу и СА запускать подпись ручной записи за специалиста (подписант — специалист
# из записи, ключ выбирает Предрейс). По ТЗ подписывает сам специалист: включать только по решению заказчика.
JOURNALS_MANAGERS_CAN_SIGN_RECORDS=false

# --- Вход пользователей: те же почта и пароль, что в Предрейсе ---
# Токен выдаёт и проверяет Предрейс (метод users/verify); секрета токенов в журналах нет.
JOURNALS_PREDREIS_USER_LOGIN_PATH=/api/v1/auth/login
# Защита входа от подбора: неудачные попытки за 5 минут по почте и по адресу (офис за NAT)
JOURNALS_LOGIN_MAX_ATTEMPTS=10
JOURNALS_LOGIN_MAX_ATTEMPTS_PER_IP=50
JOURNALS_AUTH_CACHE_TTL_S=30

# --- Yandex Vision OCR ---
JOURNALS_YANDEX_VISION_API_KEY=
JOURNALS_YANDEX_VISION_FOLDER_ID=
